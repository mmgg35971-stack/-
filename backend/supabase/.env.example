# Copy to backend/supabase/.env (never commit the real file) and set with:
#   supabase secrets set --env-file backend/supabase/.env
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

# AI providers (server only — never in the APK)
TRANSLATION_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
OCR_PROVIDER=google_vision
GOOGLE_VISION_API_KEY=

# HMAC peppers (random 32+ bytes, base64). Rotating GIFT_CODE_PEPPER invalidates unredeemed codes.
GIFT_CODE_PEPPER=
ADMIN_SECRET_PEPPER=

# Shared secret between jobs-start and the internal jobs-worker function
WORKER_SECRET=

# Google Play Billing — server-side purchase verification (billing-verify / billing-rtdn)
GOOGLE_PLAY_PACKAGE_NAME=com.mangatranslator.app
# Service account JSON (one line) with "View financial data" + "Manage orders" in Play Console
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Random secret appended to the Pub/Sub push URL: .../functions/v1/billing-rtdn?secret=<value>
PLAY_RTDN_SECRET=

# Push notifications (optional) — Firebase service account JSON (one line) with the FCM role
FCM_SERVICE_ACCOUNT_JSON=
