-- ============================================
-- 🔧 الدوال الأساسية
-- ============================================

local isRunning = false

-- دالة لإرسال الأوامر للسيرفر
local function sendAction(actionData)
    local success, err = pcall(function()
        local fishingRemote = ReplicatedStorage:FindFirstChild("Fishing")
        if fishingRemote then
            local remotes = fishingRemote:FindFirstChild("Remotes")
            if remotes then
                local actionRemote = remotes:FindFirstChild("Action")
                if actionRemote then
                    actionRemote:InvokeServer(actionData)
                end
            end
        end
    end)
    if not success then
        warn("⚠️ خطأ في إرسال الأمر: " .. tostring(err))
    end
end

-- دالة تحديث الحالة
local function updateStatus(text, color)
    statusLabel.Text = "Status: " .. text
    statusLabel.TextColor3 = color or Color3.fromRGB(180, 180, 200)
end

-- ============================================
-- 🎣 حلقة الصيد الرئيسية (مع Timeout + Cancel)
-- ============================================

local function fishingLoop()
    while isRunning do
        -- 1️⃣ رمي الصنارة
        updateStatus("Throwing 🎣", Color3.fromRGB(100, 200, 255))
        sendAction({
            ["Bait"] = BAIT_NAME,
            ["Action"] = "Throw",
            ["Goal"] = FISHING_GOAL
        })
        if not isRunning then break end
        
        -- ⏱️ ينتظر THROW_TIMEOUT ثواني
        updateStatus("Waiting after throw... ⏱️ (" .. THROW_TIMEOUT .. "s)", Color3.fromRGB(150, 150, 200))
        task.wait(THROW_TIMEOUT)
        if not isRunning then break end

        -- 2️⃣ السمكة علقت
        updateStatus("Fish Landed! 🐟", Color3.fromRGB(255, 200, 100))
        sendAction({["Action"] = "Landed"})
        if not isRunning then break end
        
        -- ⏱️ ينتظر LAND_TIMEOUT ثواني
        updateStatus("Waiting after land... ⏱️ (" .. LAND_TIMEOUT .. "s)", Color3.fromRGB(150, 150, 200))
        task.wait(LAND_TIMEOUT)
        if not isRunning then break end

        -- 3️⃣ سحب السمكة
        updateStatus("Reeling... 🎣", Color3.fromRGB(100, 255, 150))
        sendAction({["Action"] = "Reel"})
        if not isRunning then break end
        
        -- ⏱️ ينتظر REEL_TIMEOUT ثواني
        updateStatus("Waiting after reel... ⏱️ (" .. REEL_TIMEOUT .. "s)", Color3.fromRGB(150, 150, 200))
        task.wait(REEL_TIMEOUT)
        if not isRunning then break end

        -- 4️⃣ إرجاع الخطاف
        updateStatus("Returning Hook ↩️", Color3.fromRGB(200, 150, 255))
        sendAction({["Action"] = "HookReturning"})
        if not isRunning then break end
        
        -- ⏱️ ينتظر RETURN_TIMEOUT ثواني
        updateStatus("Waiting after return... ⏱️ (" .. RETURN_TIMEOUT .. "s)", Color3.fromRGB(150, 150, 200))
        task.wait(RETURN_TIMEOUT)
        if not isRunning then break end

        -- 5️⃣ إلغاء الصيد (قبل الدورة الجديدة)
        updateStatus("Canceling... ❌", Color3.fromRGB(255, 150, 100))
        sendAction({["Action"] = "Cancel"})
        if not isRunning then break end
        
        -- ⏱️ تأخير بعد Cancel قبل الدورة الجديدة
        updateStatus("Waiting for next cycle... ⏱️ (" .. CANCEL_DELAY .. "s)", Color3.fromRGB(150, 150, 200))
        task.wait(CANCEL_DELAY)
        if not isRunning then break end
    end
    updateStatus("Stopped ⏹️", Color3.fromRGB(220, 100, 100))
end

-- ============================================
-- 🎮 أحداث الأزرار
-- ============================================

closeButton.MouseButton1Click:Connect(function()
    isRunning = false
    screenGui:Destroy()
end)

toggleButton.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    
    if isRunning then
        toggleButton.Text = "⏸ Stop Auto Fish"
        toggleButton.BackgroundColor3 = Color3.fromRGB(220, 70, 70)
        updateStatus("Starting... 🚀", Color3.fromRGB(100, 255, 150))
        task.spawn(fishingLoop)
    else
        toggleButton.Text = "▶ Start Auto Fish"
        toggleButton.BackgroundColor3 = Color3.fromRGB(70, 200, 100)
        updateStatus("Idle 💤", Color3.fromRGB(180, 180, 200))
    end
end)

-- تأثيرات hover
